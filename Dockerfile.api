# syntax=docker/dockerfile:1
# API de Boletera (NestJS).
#
# Una sola etapa a propósito: `dist` importa paquetes del workspace
# (@boletera/database, @boletera/shared, …) que pnpm enlaza con symlinks a
# packages/*. La versión anterior copiaba solo dist + node_modules raíz, así que
# esos enlaces quedaban rotos, y `npm run build || true` escondía si el build
# fallaba: la imagen se armaba igual y el contenedor moría al arrancar.

FROM node:22-alpine

# Prisma necesita OpenSSL en Alpine para su motor de consultas.
RUN apk add --no-cache openssl && npm install -g pnpm@10.30.3

WORKDIR /app

COPY . .

# postinstall genera el cliente de Prisma para esta plataforma (linux-musl).
# Almacén de pnpm compartido entre imágenes: solo la primera descarga los paquetes.
RUN --mount=type=cache,id=boletera-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Paquetes del workspace cuyo main apunta a dist/ (no se versiona). pnpm -r
# respeta el orden de dependencias. Si un build falla, la imagen no se arma.
RUN pnpm -r --filter "./packages/**" --if-present run build && \
    pnpm --filter @boletera/api run build

ENV NODE_ENV=production \
    API_PORT=4000 \
    API_HOST=0.0.0.0

WORKDIR /app/apps/api

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD node -e "require('http').get('http://localhost:4000/api/v1/health', (r) => {if (r.statusCode !== 200) process.exit(1)}).on('error', () => process.exit(1))"

EXPOSE 4000

CMD ["node", "dist/main.js"]
