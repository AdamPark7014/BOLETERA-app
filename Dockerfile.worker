# Worker de Boletera: libera holds vencidos y reconcilia SPEI.
#
# Se ejecuta con `tsx` en lugar de `node dist/index.js` a propósito:
# `@boletera/database` publica su entrypoint como TypeScript
# (`"main": "./src/index.ts"`), así que el JS compilado del worker no puede
# resolverlo en runtime. `tsx` compila en memoria y evita cambiar el layout de
# los paquetes del monorepo.

FROM node:22-alpine

WORKDIR /app

# Monorepo completo: el worker depende de @boletera/database (workspace).
COPY . .

RUN npm install -g pnpm@10.30.3 && \
    pnpm install --frozen-lockfile

ENV NODE_ENV=production

WORKDIR /app/apps/worker

# Sin servidor HTTP: el healthcheck comprueba que el proceso sigue vivo.
HEALTHCHECK --interval=60s --timeout=5s --start-period=20s --retries=3 \
    CMD pgrep -f "worker/src/index.ts" > /dev/null || exit 1

CMD ["pnpm", "exec", "tsx", "src/index.ts"]
