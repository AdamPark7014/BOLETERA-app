# =============================================================================
# Boletera — plantilla de entorno. Copia a `.env` y rellena.
#
# NINGÚN secreto de este archivo trae valor por defecto, y es intencional.
# Los valores de ejemplo que circulaban aquí antes
# ("your-super-secret-jwt-key-change-in-production",
#  "change-me-worker-reconcile-secret", …) están ahora en la lista negra de
# `apps/api/src/modules/auth/jwt-secret.ts`: el API **no arranca** si detecta
# uno de ellos, si el secreto mide menos de 32 caracteres, o si falta.
#
# Genera cada secreto (uno distinto por variable):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Puerto 5434 en el host: es el que publica docker-compose (los servicios
# nativos de PostgreSQL en Windows ocupan 5432/5433).
# Si la contraseña lleva caracteres reservados de URL (@ : / ? # &) hay que
# percent-encodearlos aquí; lo más simple es generarla sin ellos.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5434/boletera?schema=public"
# Opcional: conexión directa sin pooler (algunas plataformas lo exigen para migrar)
# DIRECT_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5434/boletera?schema=public"

# Credenciales del contenedor de Postgres (docker-compose las exige).
POSTGRES_USER=postgres
# Obligatoria. Sin valor por defecto: `docker compose up` aborta si falta.
POSTGRES_PASSWORD=
POSTGRES_DB=boletera
POSTGRES_HOST_PORT=5434
# Debe cubrir: réplicas_api * PRISMA_CONNECTION_LIMIT + worker + margen operativo.
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=512MB

# Pool de Prisma (F1-07b). Por defecto Prisma usa num_cpus*2+1 conexiones, que
# con checkout concurrente se agota y tumba toda la API.
# Regla: PRISMA_CONNECTION_LIMIT * réplicas_api < POSTGRES_MAX_CONNECTIONS - 20.
PRISMA_CONNECTION_LIMIT=20
# Segundos que una petición espera una conexión libre antes de fallar.
PRISMA_POOL_TIMEOUT=20
PRISMA_CONNECT_TIMEOUT=10
# Transacciones interactivas ($transaction(fn)): milisegundos.
PRISMA_TRANSACTION_MAX_WAIT=5000
PRISMA_TRANSACTION_TIMEOUT=10000
# Diagnóstico de picos: registra las consultas que superen PRISMA_SLOW_QUERY_MS.
PRISMA_LOG_SLOW_QUERIES=false
PRISMA_SLOW_QUERY_MS=500

# -----------------------------------------------------------------------------
# Redis — holds de asiento, colas Bull y almacenamiento del rate limiting
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST_PORT=6379
# noeviction en producción: desalojar un hold es sobreventa.
REDIS_MAXMEMORY=1gb

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Origen público del API (HTTPS en prod) — usado para la URL de IPN de Banorte.
API_PUBLIC_URL=http://127.0.0.1:4000
NODE_ENV=development
LOG_LEVEL=debug

# Swagger (F2-19). En producción queda cerrado salvo que se active aquí.
# Si se activa en producción, API_DOCS_USER y API_DOCS_PASSWORD son
# OBLIGATORIOS: el API se niega a publicar /api/docs sin Basic Auth.
ENABLE_API_DOCS=false
API_DOCS_USER=
API_DOCS_PASSWORD=

# Rate limiting (F1-19 / F2-21). Dos niveles: uno sostenido y uno de ráfaga.
# El almacenamiento es Redis (REDIS_URL) para que el límite sea global entre
# réplicas; sin Redis degrada a memoria y lo avisa en el log.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_BURST_TTL_MS=1000
THROTTLE_BURST_LIMIT=10

# Saltos de proxy delante del API (1 con un solo balanceador). OBLIGATORIO si
# hay balanceador o CDN: sin esto, `req.ip` es la IP del proxy y el rate
# limiting trata a todos los compradores como un único cliente — el límite de
# ráfaga cortaría el onsale entero. Vacío = sin proxy (desarrollo local).
TRUST_PROXY=

# -----------------------------------------------------------------------------
# Frontends
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1
# Origen público del sitio de compra (enlaces en correos, retornos de pago).
WEB_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Pagos — Banorte (Payworks / SPEI / OXXO) → cuenta empresarial del promotor
# -----------------------------------------------------------------------------
# Sin BANORTE_MERCHANT_ID el gateway opera en modo DEMO. El provider bloquea el
# modo demo cuando NODE_ENV=production, pero verifícalo antes de cada onsale.
BANORTE_MERCHANT_ID=
BANORTE_AFFILIATION=
BANORTE_TERMINAL=1
BANORTE_USER=
BANORTE_PASSWORD=
BANORTE_API_SECRET=
# CLABE Banorte del promotor (requerida para SPEI en vivo)
BANORTE_ACCOUNT_CLABE=
BANORTE_PAYWORKS_URL=https://eps.banorte.com/secure3d/Solucion3DSecure.htm
BANORTE_QUERY_URL=https://eps.banorte.com/secure3d/consultaTransaccion.htm
# Obligatorio en producción: firma del IPN / webhooks. Genéralo como los demás.
BANORTE_WEBHOOK_SECRET=
# Solo para pruebas locales. NUNCA true en producción: acepta webhooks sin firma.
BANORTE_ALLOW_UNSIGNED_WEBHOOK=false
BANORTE_RETURN_URL=http://localhost:3000
BANORTE_CANCEL_URL=http://localhost:3000
# true = una orden solo se marca pagada con confirmación real de liquidación.
PAYMENT_STRICT_SETTLEMENT=true
WORKER_AUTO_PAYOUT=false

OPENAI_API_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Secretos criptográficos — OBLIGATORIOS, sin valor por defecto
# -----------------------------------------------------------------------------
# Cada uno debe ser DISTINTO de los demás y medir al menos 32 caracteres.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Firma de los JWT de sesión. Rotarlo cierra la sesión de todos los usuarios.
JWT_SECRET=
# Caducidad del access token (2h si se omite). La revocación real no depende de
# esto: JwtStrategy relee rol/organización/active de la base en cada petición.
JWT_EXPIRATION=2h
REFRESH_TOKEN_EXPIRATION=7d
# TTL de la caché de usuario de JwtStrategy = ventana máxima de revocación (ms).
AUTH_CACHE_TTL_MS=30000

# Firma del QR rotativo de los boletos. OBLIGATORIO en producción y
# OBLIGATORIAMENTE DISTINTO de JWT_SECRET: si compartieran clave, rotar las
# sesiones invalidaría los QR de todos los boletos ya emitidos (y al revés,
# filtrar el secreto de los boletos comprometería las sesiones).
# Fuera de producción, si se deja vacío, se reutiliza JWT_SECRET.
# Rotarlo invalida los QR emitidos: nunca se rota con un evento en puerta.
TICKET_QR_SECRET=

# Autentica al worker contra las rutas internas del API (X-Internal-Secret).
# Debe ser idéntico en el proceso del API y en el del worker.
INTERNAL_API_SECRET=
API_INTERNAL_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# SSO Admin (opcional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# OBLIGATORIO si se usa SSO de Microsoft: el GUID del tenant de Azure de la
# empresa. Los alias multi-tenant ('common', 'organizations', 'consumers') se
# rechazan a propósito — con ellos entraba cualquier cuenta de Azure del mundo.
MICROSOFT_TENANT_ID=
OAUTH_ADMIN_REDIRECT_URI=http://localhost:3001/login/oauth/callback

# -----------------------------------------------------------------------------
# CORS — en producción, solo los orígenes reales (sin localhost)
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# -----------------------------------------------------------------------------
# Correo
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@boletera.com
FRAUD_ALERT_EMAIL=

# -----------------------------------------------------------------------------
# Fraude y analítica
# -----------------------------------------------------------------------------
ENABLE_FRAUD_DETECTION=true
ENABLE_ANALYTICS=true

# -----------------------------------------------------------------------------
# Almacenamiento de archivos (S3 o alternativa)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
