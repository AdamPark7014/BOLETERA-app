{
  "name": "boletera-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade ticketing platform for B2B ticket operations - mega heavy, impeccable, serving all ticketing business models",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.30.3"
  },
  "scripts": {
    "predev": "pnpm db:generate",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:taquilla": "turbo run dev --filter=taquilla",
    "dev:worker": "turbo run dev --filter=worker",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "build:admin": "turbo run build --filter=admin",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "format": "pnpm --recursive exec prettier --write .",
    "format:check": "pnpm --recursive exec prettier --check .",
    "db:generate": "pnpm --filter @boletera/database prisma:generate",
    "postinstall": "pnpm db:generate",
    "db:migrate:dev": "pnpm --filter @boletera/database prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @boletera/database prisma:migrate:deploy",
    "db:seed": "pnpm --filter @boletera/database prisma:seed",
    "db:studio": "pnpm --filter @boletera/database prisma:studio",
    "db:reset": "pnpm --filter @boletera/database prisma:reset",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "smoke:venue-engine": "pnpm --filter @boletera/venue-engine build && pnpm --filter @boletera/venue-engine smoke",
    "smoke:api": "node apps/api/scripts/smoke-interactive-status.cjs",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "check-color": "node scripts/check-color-tokens.mjs",
    "homologar-color": "node scripts/homologar-color.mjs",
    "check-dimensions": "node scripts/check-dimension-tokens.mjs",
    "check-design": "pnpm run check-color && pnpm run check-dimensions",
    "load:all-in-pricing": "node e2e/load/all-in-pricing.mjs",
    "load:bot-hoarding": "node e2e/load/bot-hoarding.mjs",
    "load:concurrent-hold": "node e2e/load/concurrent-hold.mjs",
    "load:event-cancellation": "node e2e/load/event-cancellation.mjs",
    "load:mobile-wallet-chain": "node e2e/load/mobile-wallet-chain.mjs",
    "load:oversell": "node e2e/load/oversell.mjs",
    "load:profeco-disclosure": "node e2e/load/profeco-disclosure.mjs",
    "load:sale-phase-allocation": "node e2e/load/sale-phase-allocation.mjs",
    "load:tenant-isolation": "node e2e/load/tenant-isolation.mjs",
    "load:ticket-transfer": "node e2e/load/ticket-transfer.mjs",
    "load:waiting-room": "node e2e/load/waiting-room.mjs",
    "load:onsale": "k6 run e2e/load/onsale-k6.js",
    "load:all": "node scripts/run-load-scenarios.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.3.3",
    "turbo": "^2.9.14"
  }
}
