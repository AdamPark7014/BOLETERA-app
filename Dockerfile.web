# syntax=docker/dockerfile:1
# Apps Next.js de Boletera: web (comprador), admin o taquilla, según APP_NAME.
#
# Una sola etapa: con pnpm cada app resuelve `next` y los paquetes del
# workspace desde su propio node_modules (symlinks a packages/*). La versión
# anterior copiaba solo node_modules raíz y .next, y el CMD en forma exec no
# expandía ${APP_NAME}: el contenedor no arrancaba.

FROM node:22-alpine

RUN apk add --no-cache openssl && npm install -g pnpm@10.30.3

WORKDIR /app

ARG APP_NAME=web
# Lo que verá el navegador. Next lo incrusta en el bundle al construir.
ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ARG NEXT_PUBLIC_WEB_URL=http://localhost:3000

COPY . .

# Almacén de pnpm compartido entre imágenes: solo la primera descarga los paquetes.
RUN --mount=type=cache,id=boletera-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_WEB_URL=${NEXT_PUBLIC_WEB_URL} \
    NEXT_TELEMETRY_DISABLED=1

# Primero los paquetes del workspace cuyo main apunta a dist/ (no se versiona).
RUN pnpm -r --filter "./packages/**" --if-present run build && \
    pnpm --filter @boletera/${APP_NAME} run build

ENV APP_NAME=${APP_NAME} \
    NODE_ENV=production \
    PORT=3000

EXPOSE 3000

# Forma shell para que APP_NAME y PORT se expandan al arrancar.
CMD ["sh", "-c", "cd /app/apps/$APP_NAME && exec node --max-old-space-size=1024 node_modules/next/dist/bin/next start -p ${PORT:-3000}"]
